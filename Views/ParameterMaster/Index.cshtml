@{
    ViewBag.Title = "Parameter Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    @Scripts.Render("~/App_Assets/js/ParameterMaster/ParameterMaster.js")
}

<div class="row">
    <div class="col-md-12">
        <div class="card card-primary card-outline">
            <div class="card-header justify-content-between align-items-center">
                <div class="col col-sm-10">
                    <h3 class="card-title text-lg font-weight-bold">
                        <i class="fas fa-vial mr-2 text-primary"></i>Parameter Master
                    </h3>
                </div>
                <div class="col col-sm-2 offset-sm-10 text-sm-right">
                    <button type="button" class="btn btn-blue btn-sm" data-toggle="modal" onclick="return clearfields()" data-target="#parameter_modal">
                        Add Parameter
                    </button>
                </div>
            </div>
            <div class="card-body">
                <table class="table table-sm table-bordered table-striped nowrap" style="width:100%" id="parametertable">
                    <thead>
                        <tr>
                            <th>Serial</th>
                            <th>Id</th>
                            <th data-priority="1">Parameter</th>
                            <th>Unit</th>
                            <th>Result Type</th>
                            <th>Details</th>
                            <th>Active</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="parameter_modal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="header" class="modal-title">Create Parameter</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <form>
                    <input type="hidden" id="Id" name="parameterId" value="0">

                    <div class="row">
                        <div class="form-group col-sm-12 col-md-6">
                            <label for="ParameterName">Parameter Name</label>
                            <input type="text" class="form-control validate" id="ParameterName" name="ParameterName">
                        </div>

                        <div class="form-group col-sm-12 col-md-6">
                            <label for="ShortName">Short Name</label>
                            <input type="text" class="form-control" id="ShortName" name="ShortName">
                        </div>

                        <div class="form-group col-sm-12 col-md-6">
                            <label for="Unit">Unit</label>
                            <input type="text" class="form-control" id="Unit" name="Unit">
                        </div>

                        <div class="form-group col-sm-12 col-md-6">
                            <label for="ResultType">Result Type</label>
                            <select type="text" class="form-control validate" id="ResultType" name="ResultType">
                                <option value="">Select</option>
                                <option value="Numeric">Numeric</option>
                                <option value="Text">Text</option>
                                <option value="PositiveNegative">Positive/Negative</option>
                                <option value="Dropdown">Dropdown</option>
                                <option value="Calculated">Calculated</option>
                            </select>
                        </div>

                        <div class="form-group col-sm-12 col-md-6" id="decimalPrecisionGroup">
                            <label for="DecimalPrecision">Decimal Precision</label>
                            <select type="text" class="form-control" id="DecimalPrecision" name="DecimalPrecision">
                                <option value="0">0</option>
                                <option value="1">1</option>
                                <option value="2">2</option>
                                <option value="3">3</option>
                            </select>
                        </div>

                        <div class="form-group col-sm-12 col-md-6 d-none" id="dropdownManageGroup">
                            <label>Dropdown Value List</label>
                            <button type="button" class="btn btn-outline-primary btn-block" id="btnManageDropdownValues" data-toggle="modal" data-target="#dropdown_values_modal">
                                Manage Dropdown Values
                            </button>
                        </div>

                        <div class="form-group col-sm-12 col-md-6 d-none" id="formulaBuilderGroup">
                            <label>Formula Builder</label>
                            <button type="button" class="btn btn-outline-primary btn-block" id="btnOpenFormulaBuilder" data-toggle="modal" data-target="#formula_builder_modal">
                                Open Formula Builder
                            </button>
                            <button type="button" class="btn btn-outline-success btn-block mt-2" id="btnValidateFormula">Validate Formula</button>
                        </div>

                        <div class="form-group col-sm-12 col-md-6 d-none" id="formulaGroup">
                            <label for="Formula">Formula</label>
                            <input type="text" class="form-control" id="Formula" name="Formula" readonly>
                        </div>

                        <div class="form-group col-sm-12 col-md-12">
                            <div class="icheck-success d-inline mr-3">
                                <input type="checkbox" id="AllowRange" name="AllowRange">
                                <label class="form-check-label" for="AllowRange">Allow Normal Range</label>
                            </div>
                            <div class="icheck-success d-inline mr-3">
                                <input type="checkbox" id="AllowCriticalRange" name="AllowCriticalRange">
                                <label class="form-check-label" for="AllowCriticalRange">Allow Critical Range</label>
                            </div>
                            <div class="icheck-success d-inline">
                                <input type="checkbox" id="active1" name="active">
                                <label class="form-check-label" for="active1">Active</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button class="btn btn-blue" id="btnAdd" onclick="return Add();"> <span>Add Parameter</span></button>
                <button class="btn btn-primary d-none" id="btnUpdate" onclick="return Update();">
                    <span>Update Parameter</span>
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="dropdown_values_modal">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Dropdown Values</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="input-group mb-2">
                    <input type="text" class="form-control" id="dropdownValueText" placeholder="Value">
                    <div class="input-group-append">
                        <button class="btn btn-outline-primary" type="button" id="btnAddDropdownValue">Add Value</button>
                    </div>
                </div>
                <table class="table table-sm table-bordered" id="dropdownValuesTable">
                    <thead>
                        <tr>
                            <th>Value</th>
                            <th>Display Order</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button class="btn btn-primary" type="button" id="btnSaveDropdownValues">Save Values</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="formula_builder_modal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Formula Builder</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <label>Available Parameters</label>
                        <div class="border p-2" style="height:220px; overflow:auto;" id="formulaParameterList"></div>
                    </div>
                    <div class="col-md-6">
                        <label>Operators</label>
                        <div class="mb-3" id="formulaOperatorList">
                            <button type="button" class="btn btn-outline-secondary btn-sm formula-op" data-op="+">+</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm formula-op" data-op="-">-</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm formula-op" data-op="*">*</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm formula-op" data-op="/">/</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm formula-op" data-op="(">(</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm formula-op" data-op=")">)</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm formula-op" data-op=" ">Space</button>
                        </div>
                        <label>Formula Editor</label>
                        <textarea class="form-control" id="formulaEditor" rows="6"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" id="btnClearFormula" type="button">Clear</button>
                <button class="btn btn-success" id="btnApplyFormula" type="button">Apply Formula</button>
            </div>
        </div>
    </div>
</div>
