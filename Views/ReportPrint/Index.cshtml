@{
    ViewBag.Title = "Report Print";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts {
    @Scripts.Render("~/App_Assets/js/ReportPrint/ReportPrintList.js")
}

<div class="container-fluid mt-3">
    <div class="card card-primary card-outline">
        <div class="card-header">
            <h3 class="card-title text-lg font-weight-bold">
                <i class="fas fa-print mr-2 text-primary"></i>Report Print - Bill Selection
            </h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="form-group col-md-2">
                    <label for="rpBillNo">Bill Number</label>
                    <input type="text" class="form-control" id="rpBillNo" />
                </div>
                <div class="form-group col-md-2">
                    <label for="rpSampleBarcode">Sample ID</label>
                    <input type="text" class="form-control" id="rpSampleBarcode" />
                </div>
                <div class="form-group col-md-2">
                    <label for="rpPatientName">Patient Name</label>
                    <input type="text" class="form-control" id="rpPatientName" />
                </div>
                <div class="form-group col-md-2">
                    <label for="rpMobileNo">Mobile Number</label>
                    <input type="text" class="form-control" id="rpMobileNo" />
                </div>
                <div class="form-group col-md-2">
                    <label for="rpDateFrom">Date From</label>
                    <input type="date" class="form-control" id="rpDateFrom" />
                </div>
                <div class="form-group col-md-2">
                    <label for="rpDateTo">Date To</label>
                    <input type="date" class="form-control" id="rpDateTo" />
                </div>
                <div class="form-group col-md-3">
                    <label for="rpSubDepartment">Sub Department</label>
                    <input type="text" class="form-control" id="rpSubDepartment" />
                </div>
            </div>

            <div class="mb-3">
                <button type="button" class="btn btn-primary" id="btnRpSearch">Search</button>
                <button type="button" class="btn btn-secondary" id="btnRpClear">Clear</button>
            </div>

            <div class="table-responsive">
                <table class="table table-sm table-bordered table-striped" id="rpBillTable">
                    <thead>
                        <tr>
                            <th>Bill No</th>
                            <th>Patient</th>
                            <th>Age/Gender</th>
                            <th>Mobile</th>
                            <th>Collection Barcode</th>
                            <th>Date</th>
                            <th>Authorized Tests</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>
