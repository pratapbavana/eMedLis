@{
    ViewBag.Title = "Investigation Template";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    @Scripts.Render("~/App_Assets/js/InvestigationTemplate/InvestigationTemplate.js")
}

<div class="row">
    <div class="col-md-12">
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title text-lg font-weight-bold">
                    <i class="fas fa-file-medical-alt mr-2 text-primary"></i>Investigation Template Designer
                </h3>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="form-group col-sm-12 col-md-6">
                        <label for="investigationSelect">Investigation</label>
                        <select type="text" class="form-control investigationsearch" id="investigationSelect" name="investigationSelect"> </select>
                    </div>
                    <div class="form-group col-sm-12 col-md-6 text-sm-right">
                        <button type="button" class="btn btn-blue mt-4" onclick="return saveTemplate();">Save Template</button>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4">
                        <div class="card card-outline card-secondary">
                            <div class="card-header">
                                <h5 class="card-title">Available Items</h5>
                            </div>
                            <div class="card-body">
                                <div class="form-group">
                                    <label for="headerSelect">Headers</label>
                                    <select type="text" class="form-control headersearch" id="headerSelect" name="headerSelect"> </select>
                                    <button class="btn btn-outline-primary btn-sm mt-2" onclick="return addHeader();">Add Header</button>
                                </div>

                                <div class="form-group mt-4">
                                    <label for="parameterSelect">Parameters</label>
                                    <select type="text" class="form-control parametersearch" id="parameterSelect" name="parameterSelect"> </select>
                                    <label class="mt-2" for="methodSelect">Default Method</label>
                                    <select type="text" class="form-control methodsearch" id="methodSelect" name="methodSelect"> </select>
                                    <button class="btn btn-outline-primary btn-sm mt-2" onclick="return addParameter();">Add Parameter</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-8">
                        <div class="card card-outline card-secondary">
                            <div class="card-header">
                                <h5 class="card-title">Template Design</h5>
                            </div>
                            <div class="card-body">
                                <table class="table table-sm table-bordered table-striped nowrap" style="width:100%" id="templateTable">
                                    <thead>
                                        <tr>
                                            <th>Order</th>
                                            <th>Section</th>
                                            <th>Parameter</th>
                                            <th>Method</th>
                                            <th>Type</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-12">
                        <div class="card card-outline card-secondary">
                            <div class="card-header">
                                <h5 class="card-title">Interpretation</h5>
                            </div>
                            <div class="card-body">
                                <div class="d-flex flex-wrap mb-2">
                                    <select class="form-control form-control-sm mr-2 mb-2" style="width:180px;" onchange="return interpretationApplyFont(this.value);">
                                        <option value="">Font</option>
                                        <option value="Arial">Arial</option>
                                        <option value="Calibri">Calibri</option>
                                        <option value="Times New Roman">Times New Roman</option>
                                        <option value="Verdana">Verdana</option>
                                    </select>
                                    <select class="form-control form-control-sm mr-2 mb-2" style="width:140px;" onchange="return interpretationApplySize(this.value);">
                                        <option value="">Size</option>
                                        <option value="1">Small</option>
                                        <option value="3">Normal</option>
                                        <option value="5">Large</option>
                                        <option value="6">XL</option>
                                    </select>
                                    <select class="form-control form-control-sm mr-2 mb-2" style="width:160px;" onchange="return interpretationApplyBlock(this.value);">
                                        <option value="">Paragraph</option>
                                        <option value="P">Paragraph</option>
                                        <option value="H4">Heading</option>
                                        <option value="BLOCKQUOTE">Quote</option>
                                    </select>
                                    <button type="button" class="btn btn-outline-secondary btn-sm mr-1 mb-2" onclick="return interpretationCommand('bold');"><b>B</b></button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm mr-1 mb-2" onclick="return interpretationCommand('italic');"><i>I</i></button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm mr-1 mb-2" onclick="return interpretationCommand('underline');"><u>U</u></button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm mr-1 mb-2" onclick="return interpretationCommand('insertUnorderedList');">• List</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm mr-1 mb-2" onclick="return interpretationCommand('insertOrderedList');">1. List</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm mr-1 mb-2" onclick="return interpretationCommand('outdent');">Outdent</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm mr-1 mb-2" onclick="return interpretationCommand('indent');">Indent</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm mr-1 mb-2" onclick="return interpretationCommand('justifyLeft');">Left</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm mr-1 mb-2" onclick="return interpretationCommand('justifyCenter');">Center</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm mr-1 mb-2" onclick="return interpretationCommand('justifyRight');">Right</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm mr-1 mb-2" onclick="return interpretationCreateLink();">Link</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm mr-1 mb-2" onclick="return interpretationCommand('removeFormat');">Clear</button>
                                </div>
                                <div id="interpretationEditor" class="form-control" contenteditable="true" style="min-height:180px; height:auto; overflow:auto;"></div>
                                <small class="text-muted d-block mt-2">Use toolbar to enter interpretation. This content will be used in report print.</small>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="templateEditModal">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Parameter Row</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="editParameterName">Parameter</label>
                    <input type="text" class="form-control" id="editParameterName" readonly="readonly" />
                </div>
                <div class="form-group">
                    <label for="editMethodSelect">Default Method</label>
                    <select class="form-control" id="editMethodSelect"></select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-blue" onclick="return applyRowEdit();">Update</button>
            </div>
        </div>
    </div>
</div>
