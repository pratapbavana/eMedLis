@{
    ViewBag.Title = "Report Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts {
    @Scripts.Render("~/App_Assets/js/ReportEntry/ReportEntryList.js")
}

<div class="container-fluid mt-3">
    <div class="card card-primary card-outline">
        <div class="card-header">
            <h3 class="card-title text-lg font-weight-bold">
                <i class="fas fa-file-medical mr-2 text-primary"></i>Report Entry
            </h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="form-group col-md-2">
                    <label for="searchBillNo">Bill Number</label>
                    <input type="text" class="form-control" id="searchBillNo" />
                </div>
                <div class="form-group col-md-2">
                    <label for="searchSampleBarcode">Sample Barcode</label>
                    <input type="text" class="form-control" id="searchSampleBarcode" />
                </div>
                <div class="form-group col-md-2">
                    <label for="searchPatientName">Patient Name</label>
                    <input type="text" class="form-control" id="searchPatientName" />
                </div>
                <div class="form-group col-md-2">
                    <label for="searchMobileNo">Mobile Number</label>
                    <input type="text" class="form-control" id="searchMobileNo" />
                </div>
                <div class="form-group col-md-2">
                    <label for="searchDateFrom">Date From</label>
                    <input type="date" class="form-control" id="searchDateFrom" />
                </div>
                <div class="form-group col-md-2">
                    <label for="searchDateTo">Date To</label>
                    <input type="date" class="form-control" id="searchDateTo" />
                </div>
            </div>
            <div class="mb-3">
                <button type="button" class="btn btn-primary" id="btnSearchOrders">Search</button>
                <button type="button" class="btn btn-secondary" id="btnClearSearch">Clear</button>
            </div>

            <div class="table-responsive mb-3">
                <table class="table table-sm table-bordered table-striped" id="ordersTable">
                    <thead>
                        <tr>
                            <th>Bill No</th>
                            <th>Patient</th>
                            <th>Age/Gender</th>
                            <th>Mobile</th>
                            <th>Collection Barcode</th>
                            <th>Date</th>
                            <th>Investigations</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

        </div>
    </div>
</div>
