@{
    ViewBag.Title = "Parameter Header";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts{
    @Scripts.Render("~/App_Assets/js/ParameterHeader/ParameterHeader.js")
}

<div class="row">
    <div class="col-md-12">
        <div class="card card-primary card-outline">
            <div class="card-header justify-content-between align-items-center">
                <div class="col col-sm-10">
                    <h3 class="card-title text-lg font-weight-bold">
                        <i class="fas fa-tags mr-2 text-primary"></i>Parameter Header Master
                    </h3>
                </div>
                <div class="col col-sm-2 offset-sm-10 text-sm-right">
                    <button type="button" class="btn btn-blue btn-sm" data-toggle="modal" onclick="return clearfields()" data-target="#parameter_header_modal">
                        Add Header
                    </button>
                </div>
            </div>
            <div class="card-body">
                <table class="table table-sm table-bordered table-striped nowrap" style="width:100%" id="parameterheadertable">
                    <thead>
                        <tr>
                            <th>Serial</th>
                            <th>Id</th>
                            <th data-priority="1">Header Name</th>
                            <th>Active</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="parameter_header_modal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="header" class="modal-title">Create Parameter Header</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <form>
                    <input type="hidden" id="Id" name="parameterHeaderId" value="0">

                    <div class="form-group">
                        <label for="HeaderName">Header Name</label>
                        <input type="text" class="form-control validate" id="HeaderName" name="HeaderName">
                    </div>

                    <div class="icheck-success d-inline">
                        <input type="checkbox" id="active1" name="active">
                        <label class="form-check-label" for="active1">Active</label>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button class="btn btn-blue" id="btnAdd" onclick="return Add();"> <span>Add Header</span></button>
                <button class="btn btn-primary d-none" id="btnUpdate" onclick="return Update();">
                    <span>Update Header</span>
                </button>
            </div>
        </div>
    </div>
</div>
